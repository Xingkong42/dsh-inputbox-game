{
  "name": "dsh-inputbox-game",
  "version": "0.2.10",
  "type": "module",
  "license": "MIT",
  "author": "Xingkong42",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xingkong42/dsh-inputbox-game.git"
  },
  "homepage": "https://github.com/Xingkong42/dsh-inputbox-game#readme",
  "bugs": {
    "url": "https://github.com/Xingkong42/dsh-inputbox-game/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "description": "输入框小游戏：任务连续运行超过设定时间后，对话输入框变成自动运行的小游戏（贪吃蛇 / 乒乓 / 小鸟 / 生态箱 / 赛马 / 跳跃跑酷 / 数值跑酷 / 走迷宫）；点击输入框之外开始游戏，点击输入框即恢复正常编辑。 — Composer mini-games: the chat composer turns into an auto-playing mini game while a task keeps running. Click outside the input box to start the game.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "composer",
    "mini-game",
    "game",
    "automation"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.template.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "src/games/*.mjs",
    "scripts/build-client.mjs",
    "test/*.test.mjs",
    "DESIGN.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
